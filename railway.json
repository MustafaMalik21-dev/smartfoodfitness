{
  "$schema": "https://schema.railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd backend && ./mvnw package -DskipTests"
  },
  "deploy": {
    "startCommand": "cd backend && java -jar target/smartfoodfitness-0.0.1-SNAPSHOT.jar",
    "healthcheckPath": "/api/auth/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
